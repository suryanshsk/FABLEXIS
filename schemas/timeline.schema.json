{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fablexis Editing Timeline",
  "type": "object",
  "required": ["schema_version", "project", "tracks", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "reference_style": {"type": "object"},
    "unresolved_requirements": {
      "type": "array",
      "items": {"type": "string"}
    },
    "project": {
      "type": "object",
      "required": ["frame_rate", "width", "height", "duration_seconds", "aspect_ratio"],
      "additionalProperties": false,
      "properties": {
        "frame_rate": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "exclusiveMinimum": 0, "multipleOf": 2},
        "height": {"type": "integer", "exclusiveMinimum": 0, "multipleOf": 2},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "aspect_ratio": {"type": "string"},
        "audio_policy": {"enum": ["preserve_source_audio_if_present"]}
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "clips"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["video", "audio", "overlay", "caption"]},
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "timeline_start_seconds", "timeline_end_seconds"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "timeline_start_seconds": {"type": "number", "minimum": 0},
                "timeline_end_seconds": {"type": "number", "exclusiveMinimum": 0},
                "transition_in": {"const": "cut"},
                "mute": {"type": "boolean"},
                "source": {
                  "type": "object",
                  "required": ["path", "in_seconds", "out_seconds"],
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "in_seconds": {"type": "number", "minimum": 0},
                    "out_seconds": {"type": "number", "exclusiveMinimum": 0},
                    "identity": {"type": ["string", "null"]}
                  }
                },
                "selection": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                    "reason": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["engine", "timeline_renderer"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "timeline_renderer": {"type": "string", "minLength": 1}
      }
    }
  }
}
